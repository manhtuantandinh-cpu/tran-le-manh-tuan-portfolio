<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SSI_LongShort_WC26" targetNamespace="https://portfolio.example/longshort-case-study" exporter="Trần Lê Mạnh Tuấn — independent BA case study" exporterVersion="0.1">
  <bpmn:process id="Process_LongShort_WC26" name="Long or Short campaign — illustrative to-be process" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Customer" name="Khách hàng SSI">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ViewRules</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>VerifyAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Account</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choose</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Cutoff</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Trade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Expired</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="Campaign app">
        <bpmn:flowNodeRef>RecordPrediction</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DataOps" name="Data / Ops / Finance">
        <bpmn:flowNodeRef>Ingest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Data</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Calculate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Publish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Payout</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="15:00 ngày giao dịch liền trước">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="ViewRules" name="Xem thể lệ">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="VerifyAccount" name="Tài khoản SSI/Gmail">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Account" name="Định danh nhập thành công?">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_NoAccount" name="Nhập lại định danh">
      <bpmn:incoming>F04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Choose" name="LONG/SHORT 1 lần/ngày">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Cutoff" name="Trước hạn?">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_Expired" name="Hết hạn">
      <bpmn:incoming>F07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="RecordPrediction" name="Ghi dự đoán + biên nhận">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Trade" name="Giao dịch ở hệ thống riêng">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Ingest" name="VN30 T/phiên trước + giao dịch">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Data" name="Đủ dữ liệu?">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Pending" name="PENDING_DATA; điều tra">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Calculate" name="Tính giải ngày + rank 3 tiêu chí">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:incoming>F18</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Review" name="Duyệt snapshot">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_Approval" name="Duyệt?">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Rework" name="Tạo revision; re-run">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Publish" name="Thông báo email/iBoard; công bố">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Done" name="Kết thúc; xử lý khiếu nại">
      <bpmn:incoming>F21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="ViewRules" />
    <bpmn:sequenceFlow id="F02" sourceRef="ViewRules" targetRef="VerifyAccount" />
    <bpmn:sequenceFlow id="F03" sourceRef="VerifyAccount" targetRef="G_Account" />
    <bpmn:sequenceFlow id="F04" sourceRef="G_Account" targetRef="End_NoAccount" />
    <bpmn:sequenceFlow id="F05" sourceRef="G_Account" targetRef="Choose" />
    <bpmn:sequenceFlow id="F06" sourceRef="Choose" targetRef="G_Cutoff" />
    <bpmn:sequenceFlow id="F07" sourceRef="G_Cutoff" targetRef="End_Expired" />
    <bpmn:sequenceFlow id="F08" sourceRef="G_Cutoff" targetRef="RecordPrediction" />
    <bpmn:sequenceFlow id="F09" sourceRef="RecordPrediction" targetRef="Trade" />
    <bpmn:sequenceFlow id="F10" sourceRef="Trade" targetRef="Ingest" />
    <bpmn:sequenceFlow id="F11" sourceRef="Ingest" targetRef="G_Data" />
    <bpmn:sequenceFlow id="F12" sourceRef="G_Data" targetRef="Pending" />
    <bpmn:sequenceFlow id="F13" sourceRef="Pending" targetRef="Ingest" />
    <bpmn:sequenceFlow id="F14" sourceRef="G_Data" targetRef="Calculate" />
    <bpmn:sequenceFlow id="F15" sourceRef="Calculate" targetRef="Review" />
    <bpmn:sequenceFlow id="F16" sourceRef="Review" targetRef="G_Approval" />
    <bpmn:sequenceFlow id="F17" sourceRef="G_Approval" targetRef="Rework" />
    <bpmn:sequenceFlow id="F18" sourceRef="Rework" targetRef="Calculate" />
    <bpmn:sequenceFlow id="F19" sourceRef="G_Approval" targetRef="Publish" />
    <bpmn:sequenceFlow id="F20" sourceRef="Publish" targetRef="Payout" />
    <bpmn:task id="Payout" name="Chi thưởng/thuế/tài khoản đóng">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="F21" sourceRef="Payout" targetRef="End_Done" />
  </bpmn:process>
