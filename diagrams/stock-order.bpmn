          <dc:Bounds x="688" y="226" width="80" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_EnterOrder" bpmnElement="UserTask_EnterOrder">
        <dc:Bounds x="520" y="80" width="170" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_VerifyBalance" bpmnElement="ServiceTask_VerifyBalance">
        <dc:Bounds x="720" y="80" width="180" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_BalanceOK" bpmnElement="Gateway_BalanceOK" isMarkerVisible="true">
        <dc:Bounds x="930" y="86" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="930" y="136" width="50" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Rejected" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="1010" y="155" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1000" y="191" width="57" height="40"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_UserTask_ConfirmOrder" bpmnElement="UserTask_ConfirmOrder">
        <dc:Bounds x="1010" y="80" width="170" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_SendOrder" bpmnElement="ServiceTask_SendOrder">
        <dc:Bounds x="1210" y="80" width="180" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_MatchOrder" bpmnElement="ServiceTask_MatchOrder">
        <dc:Bounds x="1410" y="80" width="180" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Gateway_Matched" bpmnElement="Gateway_Matched" isMarkerVisible="true">
        <dc:Bounds x="1610" y="86" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1595" y="136" width="80" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Expired" bpmnElement="EndEvent_Expired">
        <dc:Bounds x="1690" y="155" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1663" y="191" width="90" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_UpdateRecords" bpmnElement="ServiceTask_UpdateRecords">
        <dc:Bounds x="1690" y="80" width="200" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ServiceTask_NotifyCustomer" bpmnElement="ServiceTask_NotifyCustomer">
        <dc:Bounds x="1910" y="80" width="200" height="56"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_EndEvent_Completed" bpmnElement="EndEvent_Completed">
        <dc:Bounds x="2130" y="96" width="36" height="36"/>
