<?xml version="1.0" encoding="utf-8"?><bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_VPS_Cloud" targetNamespace="https://example.org/illustrative-bpmn" exporter="Trần Lê Mạnh Tuấn Portfolio" exporterVersion="public-illustrative">
  <bpmn:message id="Message_AccountApproved" name="Account Approved"/>
  <bpmn:process id="Process_VPS_Buy_Stock_Cloud" name="Securities App Buy Order (Illustrative)" isExecutable="true">
    <bpmn:startEvent id="StartEvent_OpenApp" name="Open App">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_LoginRegister" name="Log in / Register">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ExistingUser" name="Existing user?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3_New</bpmn:outgoing>
      <bpmn:outgoing>Flow_4_Existing</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_eKYC" name="Perform eKYC Verification">
      
      <bpmn:incoming>Flow_3_New</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="IntermediateCatch_WaitApproval" name="Wait for Account Approval">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_AccountApproved"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="UserTask_EnterOrder" name="Enter Order Details">
      <bpmn:incoming>Flow_4_Existing</bpmn:incoming>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_VerifyBalance" name="Verify Balance">
      
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_BalanceOK" name="Balance sufficient?">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_9_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Rejected" name="Rejected (Insufficient Balance)">
      <bpmn:incoming>Flow_9_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask_ConfirmOrder" name="Confirm Order">
      <bpmn:incoming>Flow_9_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ServiceTask_SendOrder" name="Send Order to Exchange">
      
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_MatchOrder" name="Match Order (Exchange)">
      
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Matched" name="Order matched?">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_13_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Expired" name="Order Expired/Cancelled">
      <bpmn:incoming>Flow_13_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ServiceTask_UpdateRecords" name="Update Portfolio &amp; Balance">
      
      <bpmn:incoming>Flow_13_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_NotifyCustomer" name="Notify Customer (Result)">
      
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Completed" name="Transaction Completed">
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_OpenApp" targetRef="UserTask_LoginRegister"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="UserTask_LoginRegister" targetRef="Gateway_ExistingUser"/>
    <bpmn:sequenceFlow id="Flow_3_New" sourceRef="Gateway_ExistingUser" targetRef="ServiceTask_eKYC">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= isNewUser</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_4_Existing" sourceRef="Gateway_ExistingUser" targetRef="UserTask_EnterOrder"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="ServiceTask_eKYC" targetRef="IntermediateCatch_WaitApproval"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="IntermediateCatch_WaitApproval" targetRef="UserTask_EnterOrder"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="UserTask_EnterOrder" targetRef="ServiceTask_VerifyBalance"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="ServiceTask_VerifyBalance" targetRef="Gateway_BalanceOK"/>
    <bpmn:sequenceFlow id="Flow_9_No" sourceRef="Gateway_BalanceOK" targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= balance &lt; requiredAmount</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9_Yes" sourceRef="Gateway_BalanceOK" targetRef="UserTask_ConfirmOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= balance &gt;= requiredAmount</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="UserTask_ConfirmOrder" targetRef="ServiceTask_SendOrder"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="ServiceTask_SendOrder" targetRef="ServiceTask_MatchOrder"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="ServiceTask_MatchOrder" targetRef="Gateway_Matched"/>
    <bpmn:sequenceFlow id="Flow_13_No" sourceRef="Gateway_Matched" targetRef="EndEvent_Expired">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= not matched</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13_Yes" sourceRef="Gateway_Matched" targetRef="ServiceTask_UpdateRecords">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= matched</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="ServiceTask_UpdateRecords" targetRef="ServiceTask_NotifyCustomer"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="ServiceTask_NotifyCustomer" targetRef="EndEvent_Completed"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_VPS_Cloud">
    <bpmndi:BPMNPlane id="BPMNPlane_VPS_Cloud" bpmnElement="Process_VPS_Buy_Stock_Cloud">
      <bpmndi:BPMNShape id="Shape_StartEvent_OpenApp" bpmnElement="StartEvent_OpenApp">
        <dc:Bounds x="150" y="90" width="36" height="36"/>
        <bpmndi:BPMNLabel>
