      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_4_Existing" bpmnElement="Flow_4_Existing">
        <di:waypoint x="450" y="111"/>
        <di:waypoint x="520" y="108"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_5" bpmnElement="Flow_5">
        <di:waypoint x="670" y="208"/>
        <di:waypoint x="710" y="208"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_6" bpmnElement="Flow_6">
        <di:waypoint x="710" y="208"/>
        <di:waypoint x="700" y="208"/>
        <di:waypoint x="700" y="160"/>
        <di:waypoint x="690" y="140"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_7" bpmnElement="Flow_7">
        <di:waypoint x="690" y="108"/>
        <di:waypoint x="720" y="108"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_8" bpmnElement="Flow_8">
        <di:waypoint x="900" y="108"/>
        <di:waypoint x="930" y="111"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_9_No" bpmnElement="Flow_9_No">
        <di:waypoint x="955" y="136"/>
        <di:waypoint x="1010" y="173"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_9_Yes" bpmnElement="Flow_9_Yes">
        <di:waypoint x="980" y="111"/>
        <di:waypoint x="1010" y="108"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_10" bpmnElement="Flow_10">
        <di:waypoint x="1180" y="108"/>
